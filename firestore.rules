rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Users ----
    // A user may only read/write their own profile document.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- Family link helper (used to prove a caregiver was linked by a parent) ----
    match /familyLinks/{linkKey} {
      // Created by a parent for their own child profile
      allow create: if request.auth != null
                    && request.resource.data.parentEmail == request.auth.token.email
                    && request.resource.data.childName is string
                    && request.resource.data.childName.size() > 0;
      // Parents can update/delete their own links
      allow update, delete: if request.auth != null
                            && resource.data.parentEmail == request.auth.token.email;
      // Anyone signed in can read links (child data is keyed by composite email+name)
      allow read: if request.auth != null;
    }

    // ---- Activity logs ----
    match /activityLogs/{linkKey} {
      allow read, write: if request.auth != null;
      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---- Emergency contacts ----
    match /emergencyContacts/{docId} {
      allow read, write: if request.auth != null;
    }

    // ---- Emergency contacts stored under a child ----
    match /children/{linkKey} {
      allow read, write: if request.auth != null;
      match /emergencyContacts/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---- SOS alerts ----
    match /sosAlerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    // ---- Calendar events ----
    match /child_events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // ---- Caregiver live location ----
    match /caregiver_locations/{caregiverId} {
      allow read: if request.auth != null;
      // A caregiver may only update their own location document
      allow create, update: if request.auth != null && request.auth.uid == caregiverId;
      allow delete: if false;
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // ---- Fallback: deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
